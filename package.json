{
  "name": "myslp-backend",
  "version": "1.0.0",
  "private": true,
  "description": "MySLP - My Shangri-La Power REST API (Express + MongoDB)",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node src/scripts/seed.js",
    "dev:memory": "node src/scripts/devMemory.js",
    "export:db": "node src/scripts/exportDb.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.19.2",
    "helmet": "7.1.0",
    "jsonwebtoken": "9.0.2",
    "mongoose": "8.5.1",
    "morgan": "1.10.0",
    "nodemailer": "^6.9.14",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "mongodb-memory-server": "9.4.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "src/server.js"
}
